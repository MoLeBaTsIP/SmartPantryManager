<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.SmartPantry"
        tools:targetApi="31">

        <!-- Pantry List: the launcher screen -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Every other screen MUST be declared here or startActivity() crashes -->
        <activity
            android:name=".AddEditIngredientActivity"
            android:exported="false"
            android:label="@string/title_add_ingredient"
            android:parentActivityName=".MainActivity" />

        <activity
            android:name=".SuggestedRecipesActivity"
            android:exported="false"
            android:label="@string/title_suggested"
            android:parentActivityName=".MainActivity" />

        <activity
            android:name=".RecipeDetailActivity"
            android:exported="false"
            android:label="@string/title_recipe_detail"
            android:parentActivityName=".SuggestedRecipesActivity" />

        <activity
            android:name=".SettingsActivity"
            android:exported="false"
            android:label="@string/title_settings"
            android:parentActivityName=".MainActivity" />
    </application>

</manifest>
