<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F3F7FC"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- App heading -->
        <TextView
            android:id="@+id/tvAppTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Smart Pantry Manager"
            android:textColor="#17365D"
            android:textSize="27sp"
            android:textStyle="bold"
            android:gravity="center"
            android:layout_marginTop="20dp"
            android:layout_marginBottom="8dp" />

        <!-- App description -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Manage your ingredients and reduce food waste."
            android:textColor="#536579"
            android:textSize="16sp"
            android:gravity="center"
            android:layout_marginBottom="24dp" />

        <!-- Pantry section -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="My Pantry"
            android:textColor="#17365D"
            android:textSize="22sp"
            android:textStyle="bold"
            android:layout_marginBottom="12dp" />

        <!-- Add ingredient button -->
        <Button
            android:id="@+id/btnAddIngredient"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text=" + Add Ingredient "
            android:textAllCaps="false"
            android:textSize="16sp"
            android:backgroundTint="#1769AA"
            android:textColor="#FFFFFF"
            android:layout_marginBottom="16dp" />

        <!-- Pantry list container -->
        <LinearLayout
            android:id="@+id/pantryListContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#FFFFFF"
            android:padding="16dp">

            <!-- Empty pantry message -->
            <TextView
                android:id="@+id/tvPantryEmpty"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Your pantry is empty.\nAdd ingredients to get started."
                android:textColor="#64748B"
                android:textSize="16sp"
                android:gravity="center"
                android:padding="24dp" />

        </LinearLayout>

        <!-- Suggested recipes button -->
        <Button
            android:id="@+id/btnSuggestedRecipes"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Suggested Recipes"
            android:textAllCaps="false"
            android:textSize="16sp"
            android:backgroundTint="#23865B"
            android:textColor="#FFFFFF"
            android:layout_marginTop="24dp" />

        <!-- Settings button -->
        <Button
            android:id="@+id/btnSettings"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Settings"
            android:textAllCaps="false"
            android:textSize="16sp"
            android:backgroundTint="#DCE7F4"
            android:textColor="#17365D"
            android:layout_marginTop="8dp" />

        <!-- Footer -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Use what you have. Waste less."
            android:textColor="#64748B"
            android:textSize="14sp"
            android:gravity="center"
            android:layout_marginTop="24dp"
            android:layout_marginBottom="12dp" />

    </LinearLayout>

</ScrollView>
