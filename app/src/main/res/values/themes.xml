<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Light theme with an action bar (the action bar hosts the navigation menu).
         White surfaces, one green accent, no extra colours. -->
    <style name="Base.Theme.SmartPantry" parent="Theme.Material3.Light">
        <item name="colorPrimary">@color/primary</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorPrimaryContainer">@color/primary_soft</item>
        <item name="colorOnPrimaryContainer">@color/primary</item>
        <item name="colorSurface">@color/card_background</item>
        <item name="colorOnSurface">@color/ink</item>
        <item name="colorOutline">@color/divider</item>
        <item name="android:windowBackground">@color/screen_background</item>
        <item name="android:statusBarColor">@color/card_background</item>
        <item name="android:windowLightStatusBar">true</item>
    </style>

    <style name="Theme.SmartPantry" parent="Base.Theme.SmartPantry" />
</resources>
